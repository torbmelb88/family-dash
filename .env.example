# Kopier denne filen til .env og fyll inn dine egne verdier.
# Uten .env starter appen i demo-modus med syntetiske data — ingen oppsett kreves.

# Firebase web-konfig (Firebase Console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Unsplash API (valgfritt — brukes til bildesøk for middager)
VITE_UNSPLASH_ACCESS_KEY=
