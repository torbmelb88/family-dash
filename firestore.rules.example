rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kopier denne filen til firestore.rules og legg inn UID-ene til brukerne
    // som skal ha tilgang (Firebase Console -> Authentication, eller
    // `firebase auth:export`). Alle andre nektes tilgang.
    function isAllowed() {
      return request.auth != null &&
        request.auth.uid in [
          'DIN_FIREBASE_AUTH_UID_HER'
        ];
    }

    match /users/{userId} {
      allow read, write: if isAllowed() && request.auth.uid == userId;
    }

    match /families/{familyId} {
      allow read, write: if isAllowed();

      match /{document=**} {
        allow read, write: if isAllowed();
      }
    }
  }
}
