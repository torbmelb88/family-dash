# Hemmelig token som må inngå i connector-URL-en (eller sendes som header).
# Generer med: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_SECRET=change-me

# Familie-oppslag: sett eierens Firebase Auth UID (samme som i firestore.rules),
# så slås familyId opp via users/{OWNER_UID}.familyId.
OWNER_UID=

# Alternativt: lås serveren direkte til en familyId. Har forrang over OWNER_UID.
# FAMILY_ID=

# Unsplash API-nøkkel (samme som VITE_UNSPLASH_ACCESS_KEY i frontend-.env).
# Brukes til å hente bilde automatisk når add_dinner kalles uten imageUrl.
# UNSPLASH_ACCESS_KEY=
